{
  "name": "webpack-react19-template",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "clear": "rimraf dist",
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "format": "biome format --write",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "type-check": "tsc --noEmit"
  },
  "author": "",
  "license": "MIT",
  "description": "",
  "simple-git-hooks": {
    "pre-commit": "npm type-check"
  },
  "lint-staged": {
    "*.{js,json}": [
      "npm run format"
    ],
    "*.ts?(x)": [
      "npm run lint",
      "npm run format"
    ]
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.1",
    "@swc/core": "^1.13.3",
    "@swc/helpers": "^0.5.17",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "css-loader": "^7.1.2",
    "dotenv": "^17.2.1",
    "dotenv-loader": "^2.0.1",
    "globals": "^16.3.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.4",
    "react-refresh": "^0.17.0",
    "rimraf": "^6.0.1",
    "simple-git-hooks": "^2.13.1",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.6",
    "swc-minify-webpack-plugin": "^2.1.3",
    "typescript": "^5.8.3",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  }
}
